# Bu dosya bir şablondur ve GitHub'a gider. Gerçek değerler için:
#   Copy-Item .env.example .env
# sonra .env içindeki değerleri kendine göre değiştir. .env GitHub'a GİTMEZ.

# PostgreSQL (docker-compose.yml bu değerleri kullanır)
POSTGRES_USER=critify
POSTGRES_PASSWORD=change-me
POSTGRES_DB=critify_db
POSTGRES_PORT=5433

# Uygulama (NestJS bu değerleri @nestjs/config ile okur)
APP_PORT=3000

# Veritabanı bağlantısı — uygulamanın gözünden (bilgisayardaki port: 5433)
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=critify
DB_PASSWORD=change-me
DB_NAME=critify_db
